{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "default_agent": "workflow-review",
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "*": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "auth.json": "deny",
      "**/auth.json": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow"
  },
  "agent": {
    "workflow-review": {
      "description": "只读文档审查",
      "mode": "primary",
      "model": "deepseek/deepseek-flash",
      "permission": {
        "*": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          ".env": "deny",
          ".env.*": "deny",
          "**/.env": "deny",
          "**/.env.*": "deny",
          "auth.json": "deny",
          "**/auth.json": "deny",
          "*.pem": "deny",
          "*.key": "deny",
          "**/.ssh/**": "deny",
          "**/.aws/**": "deny"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow"
      },
      "prompt": "你是限定 Worker，Root 保留架构与最终验收。只执行任务指定范围；先读取任务提供的规则入口和已接受契约。不得递归委派、加载未显式启用的 Skill、读取凭据、提交、发布或修改全局配置。返回文件位置、实际检查和缺口。不得修改文件。"
    },
    "workflow-edit": {
      "description": "限定范围文档编辑",
      "mode": "primary",
      "model": "deepseek/deepseek-flash",
      "permission": {
        "*": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          ".env": "deny",
          ".env.*": "deny",
          "**/.env": "deny",
          "**/.env.*": "deny",
          "auth.json": "deny",
          "**/auth.json": "deny",
          "*.pem": "deny",
          "*.key": "deny",
          "**/.ssh/**": "deny",
          "**/.aws/**": "deny"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": {
          "*": "deny",
          "*.md": "allow",
          "**/*.md": "allow"
        }
      },
      "prompt": "你是限定 Worker，Root 保留架构与最终验收。只执行任务指定范围；先读取任务提供的规则入口和已接受契约。不得递归委派、加载未显式启用的 Skill、读取凭据、提交、发布或修改全局配置。返回文件位置、实际检查和缺口。仅修改任务明确授权的 Markdown 文件。"
    }
  }
}
